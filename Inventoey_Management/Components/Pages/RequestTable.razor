@inject NavigationManager NavigationManager
@inject ToastService ToastService
@using CommunityToolkit.Maui.Storage
@using CsvHelper
@using CsvHelper.Configuration
@using System.Globalization
@using System.Text
@using Microsoft.Maui.Storage
@using Inventoey_Management.Models

<div class="d-flex justify-content-between">
    <div>
        <Button Color="ButtonColor.Info" class="btn btn-info mb-4" @onclick="OnShowImportModalClick">استيراد البيانات <Icon Name="IconName.Inbox" /></Button>
        <Button Color="ButtonColor.Info" class="btn btn-info mb-4" @onclick="PickFolder">تصدير البيانات <Icon Name="IconName.FileArrowUp" /></Button>
    </div>
    @SavedData
</div>
<Grid TItem="Request"
      Class="table table-hover table-bordered text-nowrap"
      DataProvider="CustomersDataProvider"
      AllowPaging="true"
      AllowSorting="true"
      AllowFiltering="true"
      Responsive="true"
      AllowRowClick="true"
      OnRowClick="r => navigate(r.Item.Id)"
      Unit="Unit.Px">

    <GridColumns>
        <GridColumn TItem="Request" Freeze="true" FreezeLeftPosition="0" Sortable="true" HeaderText="رقم الطلب" PropertyName="Id" SortString="Id" SortKeySelector="item => item.Id" FilterTextboxWidth="50" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Id
        </GridColumn>
        <GridColumn TItem="Request" HeaderText="التاريخ" PropertyName="UpdatedAt" SortString="UpdatedAt" SortKeySelector="item => item.UpdatedAt" FilterTextboxWidth="80" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.UpdatedAt.Date
        </GridColumn>
        <GridColumn TItem="Request" HeaderText="حالة الطلب" PropertyName="Status" SortString="Status" SortKeySelector="item => item.Status" FilterTextboxWidth="50" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center"
            ColumnClass="@(x => x.Status == "done" ? "table-success" : x.Status == "canceled" ? "table-danger" : x.Status == "newRequest" ? "table-info" :"table-warning")">
            @RequestStatus[context.Status]
        </GridColumn>
        <GridColumn TItem="Request" Filterable="false" HeaderText="اسم المبنى" PropertyName="BuildingName" SortString="BuildingName" SortKeySelector="item => item.Client != null ? item.Client.BuildingName : null" FilterTextboxWidth="100" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Client?.BuildingName
        </GridColumn>
        <GridColumn TItem="Request" Filterable="false" HeaderText="القسم" PropertyName="Department" SortString="Department" SortKeySelector="item => item.Client != null ? item.Client.Department : null" FilterTextboxWidth="120" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Client?.Department
        </GridColumn>
        <GridColumn TItem="Request" Filterable="false" HeaderText="رقم المبنى" PropertyName="BuildingNumber" SortString="BuildingNumber" SortKeySelector="item => item.Client != null ? item.Client.BuildingNumber : null" FilterTextboxWidth="150" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Client?.BuildingNumber
        </GridColumn>
        <GridColumn TItem="Request" Filterable="false" HeaderText="رقم المكتب" PropertyName="OfficeNumber" SortString="OfficeNumber" SortKeySelector="item => item.Client != null ? item.Client.OfficeNumber : null" FilterTextboxWidth="80" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Client?.OfficeNumber
        </GridColumn>
        <GridColumn TItem="Request" HeaderText="اسم العميل" PropertyName="Name" SortString="Name" SortKeySelector="item => item.Client != null ? item.Client.Name : null" FilterTextboxWidth="80" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Client?.Name
        </GridColumn>
        <GridColumn TItem="Request" HeaderText="رقم العميل" PropertyName="Contact Number" SortString="ContactNumber" SortKeySelector="item => item.Client != null ? item.Client.ContactNumber : null" FilterTextboxWidth="80" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Client?.ContactNumber
        </GridColumn>
        <GridColumn TItem="Request" Filterable="false" HeaderText="نوع الآلة" PropertyName="MachineType" SortString="MachineType" SortKeySelector="item => item.MachineType" FilterTextboxWidth="80" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.MachineType
        </GridColumn>
        <GridColumn TItem="Request" Filterable="false" HeaderText="كود الآلة" PropertyName="MachineCode" SortString="MachineCode" SortKeySelector="item => item.MachineCode" FilterTextboxWidth="80" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.MachineCode
        </GridColumn>
        <GridColumn TItem="Request" Filterable="false" HeaderText="القطعة المستهلكة" PropertyName="Component.Name" SortString="Component.Name" SortKeySelector="item => item.Component != null ? item.Component.Name : null" FilterTextboxWidth="80" HeaderTextAlignment="Alignment.Center" TextAlignment="Alignment.Center">
            @context.Component?.Name
        </GridColumn>
    </GridColumns>
</Grid>

@* Modals *@
<Modal @ref="ImportModal" title="استيراد بيانات" IsVerticallyCentered="true">
    <BodyTemplate>
        حدد المستند المراد الاستيراد منه
        @if (!string.IsNullOrWhiteSpace(FileName))
        {
            <div class="mt-2">@FileName</div>
        }
        @if (isMathc)
        {
            <span class="text-danger">هناك عدد (@matchEntities.Count) بيانات مطابقة في قاعدة البيانات</span>
            <div class="p-2 m-1">
                <Button Color="ButtonColor.Primary" @onclick="ImportRemoveDoublicate">تخطي البيانات المكررة</Button>
                <Button Color="ButtonColor.Danger" @onclick="ImportWithDoublicate">حفظ الكل</Button>
            </div>
        }
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideImportModalClick">إلغاء</Button>
        <Button Color="ButtonColor.Danger" @onclick="CheckData">استيراد</Button>
    </FooterTemplate>
</Modal>

<Modal @ref="ExportModal" title="تصدير بيانات" IsVerticallyCentered="true">
    <BodyTemplate>
        موقع الملف: @FolderPath
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideExportModalClick">إلغاء</Button>
        <Button Color="ButtonColor.Danger" @onclick="ExportData">تصدير</Button>
    </FooterTemplate>
</Modal>

@code {
    [Inject] public IRequestService RequestService { get; set; } = default!;
    private List<Request> result = new();
    private IFolderPicker folderPicker = default!;
    private Modal ImportModal = default!;
    private Modal ExportModal = default!;
    private string FileName = string.Empty;
    private string FolderPath = string.Empty;
    private bool isMathc = false;
    private List<RequestSchema> schemaRecords = new();
    private List<Request> requestEntities = new();
    private List<Request> matchEntities = new();
    private ElementReference fileInput;
    private IEnumerable<Request> data = Array.Empty<Request>();
    private int SavedData = 0;

    private async Task<GridDataProviderResult<Request>> CustomersDataProvider(GridDataProviderRequest<Request> Request)
    {
        string sortString = "";
        SortDirection sortDirection = SortDirection.None;

        if (Request.Sorting is not null && Request.Sorting.Any())
        {
            // Note: Multi column sorting is not supported at this moment
            sortString = Request.Sorting.FirstOrDefault()!.SortString;
            sortDirection = Request.Sorting.FirstOrDefault()!.SortDirection;
        }
        result = await RequestService.GetAllWithChildern();
        data = Request.ApplyTo(result).Data ?? Enumerable.Empty<Request>();
        StateHasChanged();
        return await Task.FromResult(Request.ApplyTo(result));
    }

    private async Task CheckData()
    {
        try
        {
            var fileResult = await FilePicker.PickAsync(new PickOptions
            {
                PickerTitle = "Select Request CSV",
                FileTypes = new FilePickerFileType(new Dictionary<DevicePlatform, IEnumerable<string>>
                {
                    { DevicePlatform.WinUI, new[] { ".csv" } },
                })
            });

            if (fileResult is null)
            {
                return;
            }

            FileName = fileResult.FullPath ?? fileResult.FileName;
            using (var stream = await fileResult.OpenReadAsync())
            using (var reader = new StreamReader(stream, Encoding.UTF8))
            using (var csv = new CsvReader(reader, CultureInfo.InvariantCulture))
            {
                schemaRecords = csv.GetRecords<RequestSchema>().ToList();
                requestEntities = schemaRecords.Select(MapSchemaToRequest).ToList();
                matchEntities = await RequestService.MatchRecords(requestEntities);
                isMathc = matchEntities.Count > 0;
                StateHasChanged();
            }
        }
        catch
        {
            ShowErrorToast("استيراد البيانات", "هناك خطأ في استيراد البيانات");
        }
    }

    private async Task ImportWithDoublicate()
    {
        try
        {
            SavedData = await RequestService.ImportData(requestEntities);
            await ImportModal.HideAsync();
            ShowSuccessToast("استيراد البيانات", "تم استيراد البيانات بنجاح");
            StateHasChanged();
        }
        catch
        {
            ShowErrorToast("استيراد البيانات", "هناك خطأ في استيراد البيانات");
        }
    }

    private async Task ImportRemoveDoublicate()
    {
        try
        {
            foreach (Request match in matchEntities)
            {
                requestEntities.RemoveAll(t => t.Id == match.Id);
            }

            await RequestService.ImportData(requestEntities);
            await ImportModal.HideAsync();
            ShowSuccessToast("استيراد البيانات", "تم استيراد البيانات بنجاح");
        }
        catch
        {
            ShowErrorToast("استيراد البيانات", "هناك خطأ في استيراد البيانات");
        }
    }

    private async void ExportData()
    {
        try
        {
            string file = $"\\Request{DateTime.Now:yyyy-MM-dd_HH-mm-ss}.csv";
            string fullPath = string.Concat(FolderPath, file);
            using (var writer = new StreamWriter(fullPath, false, new UTF8Encoding(encoderShouldEmitUTF8Identifier: true)))
            using (var csv = new CsvWriter(writer, CultureInfo.InvariantCulture))
            {
                if (result.Count > 0)
                {
                    var schemas = data.Select(MapRequestToSchema).ToList();
                    csv.WriteRecords(schemas);
                }
            }

            await ExportModal.HideAsync();
            ShowSuccessToast("تصدير البيانات", "تم تصدير البيانات بنجاح");
        }
        catch
        {
            ShowErrorToast("تصدير البيانات", "هناك خطأ في تصدير البيانات");
        }
    }

    private Request MapSchemaToRequest(RequestSchema schema)
    {
        var client = new Client
        {
            Name = schema.ClientName,
            ContactNumber = schema.ClientPhoneNumber,
            BuildingName = schema.BuildingName,
            BuildingNumber = schema.BuildingNumber,
            OfficeNumber = schema.OfficeNumber,
            Department = schema.Department
        };

        var technician = new Technician
        {
            Name = schema.TechnicianName,
            PhoneNumber = schema.TechnicianPhoneNumber
        };

        return new Request
        {
            Id = schema.Id,
            Status = schema.Status,
            MachineType = schema.MachineType,
            MachineCode = schema.MachineCode,
            Note = schema.Note,
            ClientId = client.Id,
            TechnicianId = technician.Id,
            Client = client,
            Technician = technician
        };
    }

    private RequestSchema MapRequestToSchema(Request request)
    {
        return new RequestSchema
        {
            Id = request.Id,
            Status = request.Status,
            MachineType = request.MachineType ?? string.Empty,
            MachineCode = request.MachineCode ?? string.Empty,
            Note = request.Note ?? string.Empty,
            ClientName = request.Client?.Name ?? string.Empty,
            ClientPhoneNumber = request.Client?.ContactNumber ?? string.Empty,
            Department = request.Client?.Department ?? string.Empty,
            BuildingNumber = request.Client?.BuildingNumber ?? 0,
            BuildingName = request.Client?.BuildingName ?? string.Empty,
            OfficeNumber = request.Client?.OfficeNumber ?? string.Empty,
            TechnicianName = request.Technician?.Name ?? string.Empty,
            TechnicianPhoneNumber = request.Technician?.PhoneNumber ?? string.Empty,
            SpareCode = request.Component?.Code ?? string.Empty
        };
    }

    private void ShowSuccessToast(string title, string message)
    {
        var toastMessage = new ToastMessage
        {
            Title = title,
            Message = message,
            AutoHide = true,
            Type = ToastType.Success,
            IconName = IconName.CheckCircleFill,
        };

        ToastService.Notify(toastMessage);
    }

    private void ShowErrorToast(string title, string message)
    {
        var toastError = new ToastMessage
        {
            Title = title,
            Message = message,
            AutoHide = true,
            Type = ToastType.Danger,
            IconName = IconName.Bug,
        };

        ToastService.Notify(toastError);
    }

    private void OnFileSelected(ChangeEventArgs args)
    {
        FileName = args.Value?.ToString() ?? string.Empty;
        StateHasChanged();
    }
    private async Task OnShowImportModalClick()
    {
        await ImportModal.ShowAsync();
    }

    private async Task OnHideImportModalClick()
    {
        await ImportModal.HideAsync();
    }
    private async Task OnShowExportModalClick()
    {
        await ExportModal.ShowAsync();
    }

    private async Task OnHideExportModalClick()
    {
        await ExportModal.HideAsync();
    }

    private async Task PickFolder()
    {
        var result = await FolderPicker.Default.PickAsync();
        if (result.IsSuccessful)
        {
            FolderPath = result.Folder.Path;
            await ExportModal.ShowAsync();
        }
    }
    private void navigate(int Id)
    {
        NavigationManager.NavigateTo($"/request/{Id}");
    }
    private Dictionary<string, string> RequestStatus = new Dictionary<string, string>
    {
        {"newRequest", "طلب جديد"},
        {"pending", "تحت المعالجة"},
        {"canceled", "ملغي"},
        {"done", "مغلق"}
    };
}
