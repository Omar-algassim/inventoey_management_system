@page "/request/{Id:int}"

@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager

<style>
    .valid.modified:not([type=checkbox]) {
        outline: 1px solid #26b050;
    }

    .invalid {
        outline: 1px solid red;
    }

    .validation-message {
        color: red;
    }
</style>
<h1 class="m-xxl-3">تعديل طلب</h1>
@if (request == null)
{
    <p>Loading...</p>
}
<EditForm Model="@request" OnValidSubmit="HandleOnValidSubmit" OnInvalidSubmit="InvalidateForm">
    <DataAnnotationsValidator  />
    <ValidationSummary />
    <h3 class="mt-lg-5">معلومات الموظف</h3>
    @* Choose exist client *@
    <div class="form-group m-4 mb-3">
        <label class="col-form-label w-100">اختر موظفًا موجودًا</label>
        <div>
            <InputSelect @bind-Value="clientId" class="form-control" @bind-Value:after="OnClientSelected">
                <option value="">-- اختر موظفًا --</option>
                @foreach (var c in clients)
                {
                    <option value="@c.Id">@c.Name</option>
                }
            </InputSelect>
        </div>
    </div>

    <div class="container gap-3 border border-1 border-black rounded-3 p-3 m-4">
       <div class="row">
        <div class="form-group col mb-3">
            <label class="col-form-label w-100">اسم الموظف <span class="text-danger">*</span></label>
            <div>
                <InputText class="form-control" disabled="@true" @bind-Value="client.Name" Placeholder="Enter Full name" />
                <ValidationMessage For="@(() => client.Name)" />
            </div>
        </div>

        <div class="form-group col mb-3">
            <label class="col-form-label w-100">رقم التواصل <span class="text-danger">*</span></label>
            <div>
                    <InputText @bind-Value="client.ContactNumber" disabled="@true" class="form-control" Placeholder="Enter contact Number" />
                <ValidationMessage For="@(() => client.ContactNumber)" />
            </div>
        </div>
            <div class="form-group col mb-3">
                <label class="col-form-label w-100">أسم المبنى<span class="text-danger">*</span></label>
                <div>
                    <InputText @bind-Value="client.BuildingName" disabled="@true" class="form-control" Placeholder="Enter the Department" />
                    <ValidationMessage For="@(() => client.BuildingName)" />
                </div>
            </div>
        </div>

        <div class="row">
            <div class="form-group col mb-3">
                <label class="col-form-label w-100">رقم المبنى<span class="text-danger">*</span></label>
                <div>
                    <InputNumber @bind-Value="client.BuildingNumber" disabled="@true" class="form-control" Placeholder="Enter building Number" />
                    <ValidationMessage For="@(() => client.BuildingNumber)" />
                </div>
            </div>

            <div class="form-group col mb-3">
                <label class="col-form-label w-100">رقم المكتب <span class="text-danger">*</span></label>
                <div>
                    <InputText @bind-Value="client.OfficeNumber" disabled="@true" class="form-control" Placeholder="Enter office Number" />
                    <ValidationMessage For="@(() => client.OfficeNumber)" />
                </div>
            </div>

            <div class="form-group col mb-3">
                <label class="col-form-label w-100">القسم<span class="text-danger">*</span></label>
                <div>
                    <InputText @bind-Value="client.Department" disabled="@true" class="form-control" Placeholder="Enter the Department" />
                    <ValidationMessage For="@(() => client.Department)" />
                </div>
            </div>
        </div>

    </div>
    <h3 class="mt-lg-5">معلومات الطلب</h3>
    <div class="container gap-3 border border-1 border-black rounded-3 p-3 m-4">
        <div class="row">
            <div class="form-group col mb-3">
                <label class="col-form-label w-100">نوع الالة<span class="text-danger">*</span></label>
                <div>
                    <InputText @bind-Value="request.MachineType" class="form-control" Placeholder="Enter the Machine type" />
                    <ValidationMessage For="@(() => request.MachineType)" />
                </div>
            </div>
            <div class="form-group col mb-3">
                <label class="col-form-label w-100">كود الالة<span class="text-danger">*</span></label>
                <div>
                    <InputText @bind-Value="request.MachineCode" class="form-control" Placeholder="Enter the Machine code" />
                    <ValidationMessage For="@(() => request.MachineCode)" />
                </div>
            </div>
        </div>
        <div class="row">
            <div class="form-group col mb-3">
            <label>اختر قطعة غيار</label>
                <InputSelect @bind-Value="componentId" class="form-control" @bind-Value:after="OnComponentSelected">
                <option value="">-- Choose spare part --</option>
                    @foreach (var c in components)
                {
                    <option value="@c.Id">@c.Name   |   @c.Code </option>
                }
            </InputSelect>
            @if (component != null && 0 >= component.Amount) {<p class="text-danger">لا تتوفر هذه القطعة في المخزن</p>}
            </div>
            @if (component != null)
            {
                <div class="col w-25 d-flex justify-content-between mb-2">
                    <div class="">
                    <label>عدد القطع</label>
                        <NumberInput TValue="int" @bind-Value="request.ComponentQuantity" EnableMinMax="@true" Max="@component.Amount" Min="0" class="form-control w-50" />
                        <ValidationMessage For="@(() => request.ComponentQuantity)" />
                    </div>
                    <p class="mt-3">القطع المستهلكة : @componentQuantity</p>
                </div>
            }
            <div class="form-group col mb-3">
                <div>
                    <label>حالة الطلب</label>
                    <Badge Color="@colorBage" Type VisuallyHiddenText="@RequestStatus[request.Status]">@RequestStatus[request.Status]</Badge>
                </div>
                <InputSelect @bind-Value="status" class="form-control" @bind-Value:after="OnStatusSelected">
                    <option value="newRequest">طلب جديد</option>
                    <option value="pending">تحت المعالجة</option>
                    <option value="canceled">ملغي</option>
                    <option value="done">مغلق</option>
                </InputSelect>
            </div>
        </div>
        <div class="form-group col mb-3">
            <label class="col-form-label w-100">ملاحظات</label>
            <div>
                <TextAreaInput @bind-Value="request.Note" class="form-control" Placeholder="Enter Notes" />
                <ValidationMessage For="@(() => request.Note)" />
            </div>
        </div>
    </div>
    <h3 class="mt-lg-5">معلومات الفني</h3>
    <div class="container gap-3 border border-1 border-black rounded-3 p-3 m-4">
        <div>
            <label>اختر فني من القائمة</label>
            <InputSelect @bind-Value="technicianId" class="form-control" @bind-Value:after="OnTechnicianSelected">
                <option value="">-- Choose Technicain --</option>
                @foreach (var tech in technicians)
                {
                    <option value="@tech.Id">@tech.Name</option>
                }
            </InputSelect>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 m-3 text-right d-flex w-auto justify-content-between">
            <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" Class="float-end" @onclick="Cancel">إلغاء</Button>
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Class="float-end me-2">حفظ</Button>
            <Button Type="ButtonType.Button" Color="ButtonColor.Danger" Class="float-end me-4" @onclick="OnShowModalClick">مسح</Button>
        </div>
    </div>
</EditForm>
<Modal @ref="modal" title="تأكيد" IsVerticallyCentered="true">
    <BodyTemplate>
        هل تريد فعلا حذف هذا الطلب؟
        <Icon Name="IconName.Trash" Size="IconSize.x4" Color="IconColor.Danger" class="mr-5" />
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">إلغاء</Button>
        <Button Color="ButtonColor.Danger" @onclick="DeleteRequest">حذف</Button>
    </FooterTemplate>
</Modal>

@code {
    [Parameter]
    public int Id { get; set; }
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private IClientService ClientService { get; set; } = default!;
    [Inject] private IComponentService ComponentService { get; set; } = default!;
    [Inject] private ITechnicianService TechnicianService { get; set; } = default!;
    [Inject] private IRequestService RequestService { get; set; } = default!;

    private Modal modal = default!;
    private Client client = new Client();
    private Request request = new();
    private Component component = null!;
    private Technician technician = new Technician();
    private EditContext? editContext;
    private int clientId;
    private int? componentId;
    private int technicianId;
    private int componentQuantity = 0;
    private string status = "";
    private Client[] clients = [];
    private Component[] components = [];
    private Technician[] technicians = [];
    private BadgeColor colorBage;

    protected override async Task OnInitializedAsync()
    {
        clients = (await ClientService.GetAllAsync()).ToArray();
        components = (await ComponentService.GetAllAsync()).ToArray();
        technicians = (await TechnicianService.GetAllAsync()).ToArray();
        request = await RequestService.GetByIdAsync(Id);
        status = request.Status;
        componentQuantity = request.ComponentQuantity;

        // Handle potentially unassigned technician ID
        if (request.TechnicianId > 0)
        {
            var fetchedTechnician = await TechnicianService.GetByIdAsync(request.TechnicianId);
            if (fetchedTechnician != null)
                technician = fetchedTechnician;
        }

        clientId = request.ClientId;
        technicianId = request.TechnicianId;

        // Handle potentially unassigned client ID
        if (request.ClientId > 0)
        {
            var fetchedClient = await ClientService.GetByIdAsync(clientId);
            if (fetchedClient != null)
                client = fetchedClient;
        }
        if (request.ComponentId > 0)
        {
            var fetchedComponent = await ComponentService.GetByIdAsync(request.ComponentId);
            if (fetchedComponent != null)
            {
                component = fetchedComponent;
                componentId = component.Id;
            }
        }

        colorBage = status == "done"
            ? BadgeColor.Success
            : status == "canceled"
                ? BadgeColor.Danger
                : status == "newRequest"
                ? BadgeColor.Info
                : BadgeColor.Warning;
    }

    public async void HandleOnValidSubmit()
    {
        request.Client = client;
        request.ClientId = clientId;
        request.Technician = technician;
        request.TechnicianId = technicianId;
        if (componentId.HasValue)
        {
            await ComponentService.UpdateStockAsync(component.Id, request.ComponentQuantity);
            request.Component = component;
        }
        else request.Component = null;
        request.Status = status;
        await RequestService.UpdateWithChilderenAsync(request);

        var toastMessage = new ToastMessage
        {
            Title = "حفظ بيانات الطلب",
            Message = $"تم حفظ بيانات الطلب بنجاح",
            AutoHide = true,
            Type = ToastType.Success,
            IconName = IconName.CheckCircleFill,
        };

        ToastService.Notify(toastMessage);
        NavigationManager.NavigateTo("/request");
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/request");
    }

    private void OnClientSelected()
    {
        if (clientId > 0)
        {
            var selectedClient = clients.FirstOrDefault(c => c.Id == clientId);
            if (selectedClient != null)
            {
                // Copy values from selected client to the current client instance
                client.Name = selectedClient.Name;
                client.ContactNumber = selectedClient.ContactNumber;
                client.BuildingNumber = selectedClient.BuildingNumber;
                client.OfficeNumber = selectedClient.OfficeNumber;
                client.Department = selectedClient.Department;
            }
        }
        else
        {
            // Clear the form when no client is selected
            client = new Client();
        }
    }
    private async void OnComponentSelected()
    {
        if (componentId.HasValue)
        {
            component = await ComponentService.GetByIdAsync(componentId.Value);
        }
        else
        {
            component = null!;
        }
        StateHasChanged();
    }
    private void OnStatusSelected()
    {
        colorBage = status == "done"
            ? BadgeColor.Success
            : status == "canceled"
                ? BadgeColor.Danger
                : status == "newRequest"
                ? BadgeColor.Info
                : BadgeColor.Warning;
    }
    private async void OnTechnicianSelected()
    {
        if (technicianId > 0)
        {
            technician = await TechnicianService.GetByIdAsync(technicianId);
        }
    }
    private async void DeleteRequest()
    {
        try
        {
            await RequestService.DeleteAsync(request);
        }
        catch
        {
            var toastError = new ToastMessage
            {
                Title = "حذف بيانات الطلب",
                Message = $"حدث خطأ اثناء الحذف",
                AutoHide = true,
                Type = ToastType.Danger,
                IconName = IconName.Bug,
            };
            ToastService.Notify(toastError);
            return;
        }
        var toastMessage = new ToastMessage
        {
            Title = "حذف بيانات الطلب",
            Message = $"تم حذف بيانات الطلب بنجاح",
            AutoHide = true,
            Type = ToastType.Success,
            IconName = IconName.CheckCircleFill,
        };
        ToastService.Notify(toastMessage);
        NavigationManager.NavigateTo("/request");
    }
    private async Task OnShowModalClick()
    {
        await modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }
    private void InvalidateForm()
    {
        var toastMessage = new ToastMessage
        {
            Title = "invalid Form",
            Message = $"",
            AutoHide = true,
            Type = ToastType.Success,
            IconName = IconName.CheckCircleFill,
        };
        ToastService.Notify(toastMessage);
    }
    private Dictionary<string, string> RequestStatus = new Dictionary<string, string>
    {
        {"newRequest", "طلب جديد"},
        {"pending", "تحت المعالجة"},
        {"canceled", "ملغي"},
        {"done", "مغلق"}
    };
}

