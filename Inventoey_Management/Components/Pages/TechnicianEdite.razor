@page "/technician/{Id:int}"

@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager

<style>
    .valid.modified:not([type=checkbox]) {
        outline: 1px solid #26b050;
    }

    .invalid {
        outline: 1px solid red;
    }

    .validation-message {
        color: red;
    }
</style>
<h1 class="m-xxl-3">الفني جديد</h1>
@if (technician == null)
{
    <p>Loading...</p>
}
<EditForm Model="@technician" OnValidSubmit="HandleOnValidSubmit">
    <DataAnnotationsValidator />
    <h3 class="mt-lg-5">معلومات الفني</h3>

    <div class="container gap-3 border border-1 border-black rounded-3 p-3 m-4">
        <div class="row">
            <div class="form-group col mb-3">
                <label class="col-form-label w-100">اسم الفني<span class="text-danger">*</span></label>
                <div>
                    <InputText class="form-control" @bind-Value="technician.Name" Placeholder="Enter Full name" />
                    <ValidationMessage For="@(() => technician.Name)" />
                </div>
            </div>

            <div class="form-group col mb-3">
                <label class="col-form-label w-100">رقم الفني <span class="text-danger">*</span></label>
                <div>
                    <InputText @bind-Value="technician.PhoneNumber" class="form-control" Placeholder="Enter Phone Number" />
                    <ValidationMessage For="@(() => technician.PhoneNumber)" />
                </div>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12 m-3 text-right d-flex w-auto justify-content-between">
            <Button Type="ButtonType.Button" Color="ButtonColor.Secondary" Class="float-end" @onclick="Cancel">إلغاء</Button>
            <Button Type="ButtonType.Submit" Color="ButtonColor.Success" Class="float-end me-2">حفظ</Button>
            <Button Type="ButtonType.Button" Color="ButtonColor.Danger" Class="float-end me-4" @onclick="OnShowModalClick">مسح</Button>
        </div>
    </div>
</EditForm>
<Modal @ref="modal" title="تأكيد" IsVerticallyCentered="true">
    <BodyTemplate>
        هل تريد فعلا حذف هذا الفني؟
        <Icon Name="IconName.Trash" Size="IconSize.x4" Color="IconColor.Danger" class="mr-5" />
    </BodyTemplate>
    <FooterTemplate>
        <Button Color="ButtonColor.Secondary" @onclick="OnHideModalClick">إلغاء</Button>
        <Button Color="ButtonColor.Danger" @onclick="DeleteTechnician">حذف</Button>
    </FooterTemplate>
</Modal>

@code {
    [Parameter]
    public int Id { get; set; }
    [Inject] private ToastService ToastService { get; set; } = default!;
    [Inject] private ITechnicianService technicianService { get; set; } = default!;

    private Modal modal = default!;
    private Technician technician = new();
    private EditContext? editContext;


    protected override async Task OnInitializedAsync()
    {
        await technicianService.GetByIdAsync(Id).ContinueWith(task =>
        {
            technician = task.Result;
        });
    }


    public async void HandleOnValidSubmit()
    {
        try
        {
            await technicianService.UpdateAsync(technician.Id, technician);
        }
        catch
        {
            var toastError = new ToastMessage
            {
                Title = "حفظ بيانات الفني",
                Message = $"حدث خطأ اثناء الحفظ",
                AutoHide = true,
                Type = ToastType.Danger,
                IconName = IconName.Bug,
            };
        }

        var toastMessage = new ToastMessage
        {
            Title = "حفظ بيانات الفني",
            Message = $"تم حفظ بيانات الفني بنجاح",
            AutoHide = true,
            Type = ToastType.Success,
            IconName = IconName.CheckCircleFill,
        };

        ToastService.Notify(toastMessage);
        NavigationManager.NavigateTo("/technicians");
    }

    private void Cancel()
    {
        NavigationManager.NavigateTo("/technicians");
    }
    private async Task OnShowModalClick()
    {
        await modal.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await modal.HideAsync();
    }
    private async void DeleteTechnician()
    {
        try
        {
            await technicianService.DeleteAsync(technician);
        }
        catch
        {
            var toastError = new ToastMessage
            {
                Title = "حذف بيانات الفني",
                Message = $"حدث خطأ اثناء الحذف",
                AutoHide = true,
                Type = ToastType.Danger,
                IconName = IconName.Bug,
            };
            ToastService.Notify(toastError);
            return;
        }
        var toastMessage = new ToastMessage
        {
            Title = "حذف بيانات الفني",
            Message = $"تم حذف بيانات الفني بنجاح",
            AutoHide = true,
            Type = ToastType.Success,
            IconName = IconName.CheckCircleFill,
        };
        ToastService.Notify(toastMessage);
        NavigationManager.NavigateTo("/technicians");
    }
}
